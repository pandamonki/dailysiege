rules_version = '2';

// Daily Siege security rules.
//
// The point of these rules is the fog of war: nobody but you (and the server) can read your orders
// or your private state, and nobody can change orders once the day's lock has passed.
//
//   config/app                               who owns this site and who may host games
//   users/{uid}                              a signed-in person's own settings
//   invites/{code}                           invite code -> game (knowing the code is the invitation)
//   games/{g}                                public game settings; the clock fields are server-owned
//   games/{g}/members/{uid}                  "this account was invited": gates every other read
//   games/{g}/players/{uid}                  public profile: names, banner, sealed-or-not (never the orders)
//   games/{g}/players/{uid}/private/state    gold, army, items...        owner only
//   games/{g}/players/{uid}/orders/{day}     that day's orders           owner only, until the lock
//   games/{g}/battles/{day}                  results                     server writes, members read
//
// Cloud Functions use the Admin SDK, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function gamePath(g) { return /databases/$(database)/documents/games/$(g); }
    function game(g) { return get(gamePath(g)).data; }
    function isHost(g) { return signedIn() && game(g).host == me(); }
    function isMember(g) { return signedIn() && exists(/databases/$(database)/documents/games/$(g)/members/$(me())); }
    function isMemberAfter(g) { return signedIn() && existsAfter(/databases/$(database)/documents/games/$(g)/members/$(me())); }
    // A seat is a castle in a game, named after the account that first registered it. Normally you hold the seat with
    // your own id. If you had to sign in with a new account, the server can point your membership at your old seat.
    function owns(g, uid) {
      return isMember(g) && get(/databases/$(database)/documents/games/$(g)/members/$(me())).data.get('seat', me()) == uid;
    }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // fields only the server may set: the day being planned and the instants orders lock
    function serverFields() { return ['planDay', 'nextLockAt', 'nextPlanDay', 'lockAfter', 'clockWar', 'startDate', 'resolvedAt']; }

    // ---- site ----
    // The first person to sign in after the site is deployed claims it. Only people on its hosts list may create games.
    match /config/app {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'hosts', 'createdAt'])
        && request.resource.data.owner == me()
        && request.resource.data.hosts == [me()];
      allow update: if signedIn() && resource.data.owner == me()
        && request.resource.data.owner == me()
        && request.resource.data.keys().hasOnly(['owner', 'hosts', 'createdAt'])
        && request.resource.data.hosts is list && request.resource.data.hosts.size() <= 20;
    }
    function mayHost() {
      return signedIn() && get(/databases/$(database)/documents/config/app).data.hosts.hasAny([me()]);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ---- invitations ----
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && code.size() >= 8
        && request.resource.data.keys().hasOnly(['gameId', 'createdAt'])
        && getAfter(gamePath(request.resource.data.gameId)).data.host == me()
        && getAfter(gamePath(request.resource.data.gameId)).data.inviteCode == code;
      allow delete: if signedIn() && game(resource.data.gameId).host == me();
    }

    // ---- games ----
    match /games/{g} {
      // Game ids are long random strings handed out only through an invite, so reading one needs the id.
      allow get: if signedIn();
      allow list: if false;
      allow create: if mayHost()
        && request.resource.data.host == me()
        && request.resource.data.war == 1
        && !request.resource.data.keys().hasAny(serverFields())
        && validGame();
      allow update: if isHost(g)
        && unchanged(serverFields())
        && unchanged(['host', 'createdBy'])
        && (request.resource.data.war == resource.data.war || request.resource.data.war == resource.data.war + 1)
        && validGame();
      allow delete: if false;

      function validGame() {
        let d = request.resource.data;
        return d.tz is string && d.tz.size() < 64
          && d.lockHour is int && d.lockHour >= 0 && d.lockHour <= 23
          && d.inviteCode is string && d.inviteCode.size() >= 8
          && d.get('maxPlayers', 8) is int && d.get('maxPlayers', 8) >= 2 && d.get('maxPlayers', 8) <= 12;
      }

      // "I hold the invite." Created by showing the game's current invite code; removed by leaving or being removed by the host.
      match /members/{uid} {
        allow read: if signedIn() && (me() == uid || isHost(g));
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['invite', 'at'])
          && request.resource.data.invite == getAfter(gamePath(g)).data.inviteCode
          && !wasRemoved(uid)
          && !exists(/databases/$(database)/documents/games/$(g)/banned/$(uid));
        allow update: if false;
        allow delete: if signedIn() && (me() == uid || isHost(g));

        function wasRemoved(uid) {
          let p = /databases/$(database)/documents/games/$(g)/players/$(uid);
          return exists(p) && get(p).data.get('kicked', false) == true;
        }
      }

      // Accounts that may not rejoin: removed by the host, or replaced by the same lord's new account.
      match /banned/{uid} {
        allow read: if signedIn() && (me() == uid || isHost(g));
        allow create: if isHost(g) && uid != me();
        allow update, delete: if false;
      }

      // Public profile. Everything here is visible to every lord in the game, so it never holds orders, gold or army.
      match /players/{uid} {
        allow read: if isMember(g);
        allow create: if signedIn() && me() == uid && isMemberAfter(g) && validProfile();
        allow update: if (owns(g, uid) && validProfile() && namesOk() && joinedOk())
          || (isHost(g) && onlyChanges(['left', 'kicked', 'fromWeek', 'pending']));
        allow delete: if false;

        function validProfile() {
          let d = request.resource.data;
          return d.keys().hasOnly(['fromWeek', 'joinedAt', 'nick', 'real', 'pending', 'left', 'banner', 'hasRapier', 'sealedFor', 'week', 'war'])
            && d.get('nick', '') is string && d.get('nick', '').size() <= 16
            && d.get('real', '') is string && d.get('real', '').size() <= 20
            && d.joinedAt is number
            && d.get('left', false) == (resource == null ? false : resource.data.get('left', false));
        }
        // Names are fixed once the war has begun: they can change only while registration is open,
        // before you have registered, or while you are queued for a later week.
        function namesOk() {
          let gm = game(g);
          return unchanged(['nick', 'real'])
            || resource.data.get('pending', false) == true
            || (gm.get('lobby', false) == true && (gm.get('lobbyEnds', null) == null || request.time.toMillis() < gm.lobbyEnds))
            || resource.data.get('fromWeek', '') > gm.get('planDay', '9999-99-99');
        }
        // Sign-up order decides seats, so a new sign-up time must be "now", not a date picked to jump the queue.
        function joinedOk() {
          return request.resource.data.joinedAt == resource.data.joinedAt
            || (request.resource.data.joinedAt > request.time.toMillis() - 300000 && request.resource.data.joinedAt < request.time.toMillis() + 300000);
        }

        // Gold, army, items, everything not yet revealed by a battle.
        match /private/{doc} {
          allow read, write: if owns(g, uid) && doc == 'state';
        }

        // One day's orders. Readable only by their owner, and frozen the moment that day's lock passes:
        // the server reads them after the lock, so nobody can peek and nobody can edit after the fact.
        match /orders/{day} {
          allow read: if owns(g, uid);
          allow create, update: if owns(g, uid)
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && ordersOpen(day);
          allow delete: if false;

          function ordersOpen(day) {
            let gm = game(g);
            return (day == gm.planDay && request.time < gm.nextLockAt)
              // after tonight's lock but before the server has fought the battle, tomorrow's orders may already be drafted
              || (day == gm.nextPlanDay && request.time >= gm.nextLockAt && request.time < gm.lockAfter);
          }
        }
      }

      // A device reporting that it replayed a battle differently from the official result. The host reads these.
      match /reports/{id} {
        allow create: if isMember(g) && request.resource.data.uid == me() && id == request.resource.data.day + '_' + me()
          && request.resource.data.keys().hasOnly(['uid', 'day', 'got', 'want', 'device', 'at']);
        allow read: if isHost(g);
        allow update, delete: if false;
      }

      // Results, written only by the server.
      match /battles/{day} {
        allow read: if isMember(g);
        allow write: if false;
      }
    }
  }
}
